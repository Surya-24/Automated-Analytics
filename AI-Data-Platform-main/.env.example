# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL Database Configuration
host=localhost
port=5432
user=postgres
password=postgres
database=postgres

# 1. LangSmith Tracing Configuration (Optional - set to true if using LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=ai-data-agent

# 2. Langfuse Observability Configuration (Optional - set keys if using Langfuse)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# 3. Pydantic Logfire Configuration (Optional - set token if using Logfire cloud)
LOGFIRE_TOKEN=your_logfire_token